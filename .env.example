# Copy to .env and fill in locally. Do not commit .env.
# Single-quote values containing $ or # to avoid Compose interpolation/comments.
POSTGRES_USER=university
POSTGRES_PASSWORD=
DB_PORT=5433
APP_PORT=8080
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
# At least 10 characters; at most 72 UTF-8 bytes. Only used if no enabled admin exists.
BOOTSTRAP_ADMIN_PASSWORD=
